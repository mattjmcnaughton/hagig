default:
    @just --list

build:
    cargo build --locked --all-targets

fmt:
    cargo fmt --all
    rustfmt --edition 2024 tests/fixtures/linux_worker.rs tests/fixtures/inference_peer.rs

fmt-check:
    cargo fmt --all -- --check
    rustfmt --edition 2024 --check tests/fixtures/linux_worker.rs tests/fixtures/inference_peer.rs

lint:
    cargo clippy --locked --all-targets -- -D warnings

test:
    cargo test --locked --all-targets
    cargo test --locked --doc

ci: fmt-check lint test
