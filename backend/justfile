# Check formatting
fmt:
    uv run --frozen ruff format --check .

# Fix formatting
fmt-fix:
    uv run --frozen ruff format .

# Check linting
lint:
    uv run --frozen ruff check .

# Fix linting
lint-fix:
    uv run --frozen ruff check --fix .

# Run type checker
typecheck:
    uv run --frozen ty check

# Run all tests (one pytest run, so an empty suite directory is not an error)
test-all:
    uv run --frozen pytest -v -ra

# Run unit tests
test-unit:
    uv run --frozen pytest tests/unit

# Run integration tests
test-integration:
    uv run --frozen pytest tests/integration

# Run end-to-end tests (real server, worker and CLI over the socket)
test-e2e:
    uv run --frozen pytest tests/e2e

# Fast pre-push check
gate: fmt lint typecheck test-unit

# Full check; the same commands CI runs
gate-expensive: fmt lint typecheck test-all
